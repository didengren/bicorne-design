{
  "meta": {
    "name": "stripe-light",
    "version": "1.0.0",
    "source": "references/brand-library/fintech/stripe-DESIGN.md",
    "theme": "light"
  },
  "colors": {
    "brand": {
      "50": "#f4f0ff",
      "100": "#e7deff",
      "200": "#c6b5ff",
      "300": "#a38cff",
      "400": "#7d63ff",
      "500": "#533afd",
      "600": "#3827d6",
      "700": "#2117b0",
      "800": "#0f0b8a",
      "900": "#070763"
    },
    "surface": {
      "1": "#f5f5f5",
      "2": "#fafafa",
      "3": "#f0f0f0",
      "4": "#e8e8e8",
      "base": "#ffffff"
    },
    "ink": {
      "default": "#061b31",
      "muted": "#595959",
      "subtle": "#8c8c8c",
      "tertiary": "#bfbfbf"
    },
    "border": {
      "default": "#d9d9d9",
      "strong": "#bfbfbf",
      "subtle": "#f0f0f0"
    },
    "semantic": {
      "success": "#52c41a",
      "danger": "#f5222d",
      "warning": "#faad14",
      "info": "#2468f2"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "name": "System Display",
        "stack": "'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif"
      },
      "body": {
        "name": "System Body",
        "stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "mono": {
        "name": "System Mono",
        "stack": "ui-monospace, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', Menlo, Monaco, monospace"
      }
    },
    "scales": {
      "display-xl": {
        "fontFamily": "display",
        "fontSize": "48px",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-1.5px"
      },
      "display-lg": {
        "fontFamily": "display",
        "fontSize": "40px",
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "-1.0px"
      },
      "display-md": {
        "fontFamily": "display",
        "fontSize": "32px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.5px"
      },
      "headline": {
        "fontFamily": "display",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "-0.3px"
      },
      "heading-xl": {
        "fontFamily": "display",
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": 1.35,
        "letterSpacing": "-0.2px"
      },
      "heading-lg": {
        "fontFamily": "display",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0px"
      },
      "heading-md": {
        "fontFamily": "body",
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0px"
      },
      "body-lg": {
        "fontFamily": "body",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0px"
      },
      "body-md": {
        "fontFamily": "body",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "body-sm": {
        "fontFamily": "body",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "caption": {
        "fontFamily": "body",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0.01px"
      },
      "button": {
        "fontFamily": "body",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": "0px"
      },
      "mono": {
        "fontFamily": "mono",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.7,
        "letterSpacing": "0px"
      }
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "borderRadius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "2xl": 16,
    "full": 9999
  },
  "shadows": {
    "sm": {
      "value": "0 1px 2px rgba(0,0,0,0.05)"
    },
    "md": {
      "value": "0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04)"
    },
    "lg": {
      "value": "0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04)"
    },
    "brand": {
      "value": "0 4px 14px rgba(36,104,242,0.25)"
    }
  },
  "transitions": {
    "default": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    },
    "fast": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    },
    "slow": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    }
  }
}