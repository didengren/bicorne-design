{
  "meta": {
    "name": "linear-dark",
    "version": "2.12.0",
    "source": "references/brand-library/developer-tools/linear.app-DESIGN.md",
    "theme": "dark",
    "platform": "dashboard"
  },
  "colors": {
    "brand": {
      "50": "#080816",
      "100": "#12142c",
      "200": "#1d2140",
      "300": "#2b3060",
      "400": "#828fff",
      "500": "#505ab3",
      "600": "#5e69d1",
      "700": "#acb5df",
      "800": "#dfe2f0",
      "900": "#ebeefa"
    },
    "surface": {
      "1": "#0f1011",
      "2": "#141516",
      "3": "#18191a",
      "4": "#191a1b",
      "base": "#010102"
    },
    "ink": {
      "default": "#f7f8f8",
      "muted": "#d0d6e0",
      "subtle": "#8a8f98",
      "tertiary": "#62666d"
    },
    "border": {
      "default": "#23252a",
      "strong": "#34343a",
      "subtle": "#3e3e44"
    },
    "semantic": {
      "success": "#27a644",
      "danger": "#e5484d",
      "warning": "#f5a623",
      "info": "#5e6ad2"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "name": "Linear Display",
        "stack": "'Linear Display', sans-serif",
        "fontDisplay": "swap",
        "fontWeight": [400, 500, 600, 700],
        "openTypeFeatures": ["tnum", "cv11", "ss01"]
      },
      "body": {
        "name": "Linear Text",
        "stack": "'Linear Text', sans-serif",
        "fontDisplay": "swap",
        "fontWeight": [400, 500, 600],
        "openTypeFeatures": ["cv11"]
      },
      "mono": {
        "name": "Linear Mono",
        "stack": "'Linear Mono', sans-serif",
        "fontDisplay": "swap",
        "fontWeight": [400, 500],
        "openTypeFeatures": ["tnum", "calt"]
      }
    },
    "scales": {
      "display-xl": {
        "fontFamily": "display",
        "fontSize": "96px",
        "fontWeight": 600,
        "lineHeight": 1.05,
        "letterSpacing": "-3.0px"
      },
      "display-lg": {
        "fontFamily": "display",
        "fontSize": "72px",
        "fontWeight": 600,
        "lineHeight": 1.1,
        "letterSpacing": "-1.8px"
      },
      "display-md": {
        "fontFamily": "display",
        "fontSize": "56px",
        "fontWeight": 600,
        "lineHeight": 1.15,
        "letterSpacing": "-1.0px"
      },
      "headline": {
        "fontFamily": "display",
        "fontSize": "44px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.6px"
      },
      "heading-xl": {
        "fontFamily": "display",
        "fontSize": "36px",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "-0.5px"
      },
      "heading-lg": {
        "fontFamily": "display",
        "fontSize": "30px",
        "fontWeight": 600,
        "lineHeight": 1.35,
        "letterSpacing": "-0.3px"
      },
      "heading-md": {
        "fontFamily": "body",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0px"
      },
      "body-lg": {
        "fontFamily": "body",
        "fontSize": "22px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "-0.1px"
      },
      "body-md": {
        "fontFamily": "body",
        "fontSize": "20px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "body-sm": {
        "fontFamily": "body",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      },
      "caption": {
        "fontFamily": "body",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0px"
      },
      "eyebrow": {
        "fontFamily": "body",
        "fontSize": "14px",
        "fontWeight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "0.4px"
      },
      "micro": {
        "fontFamily": "body",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "0.5px"
      },
      "button": {
        "fontFamily": "body",
        "fontSize": "16px",
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": "0px"
      },
      "mono": {
        "fontFamily": "mono",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0px"
      }
    }
  },
  "spacing": {
    "1": 8,
    "2": 16,
    "3": 24,
    "4": 32,
    "5": 40,
    "6": 48,
    "8": 64,
    "10": 80,
    "12": 96,
    "16": 128
  },
  "borderRadius": {
    "none": 0,
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 28,
    "full": 9999
  },
  "shadows": {
    "sm": {
      "value": "0 2px 4px rgba(0,0,0,0.45)"
    },
    "md": {
      "value": "0 6px 12px rgba(0,0,0,0.45)"
    },
    "lg": {
      "value": "0 12px 36px rgba(0,0,0,0.6)"
    },
    "brand": {
      "value": "0 6px 18px rgba(94,106,210,0.375)"
    }
  },
  "transitions": {
    "default": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    },
    "fast": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    },
    "slow": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.215,0.61,0.355,1)"
    },
    "expand": {
      "duration": "200ms",
      "easing": "ease-in-out"
    },
    "collapse": {
      "duration": "150ms",
      "easing": "ease-in"
    },
    "modal-enter": {
      "duration": "280ms",
      "easing": "ease-out"
    },
    "modal-exit": {
      "duration": "180ms",
      "easing": "ease-in"
    },
    "toast-enter": {
      "duration": "300ms",
      "easing": "ease-out"
    },
    "toast-exit": {
      "duration": "200ms",
      "easing": "ease-in"
    },
    "scroll-reveal": {
      "duration": "500ms",
      "easing": "cubic-bezier(0.16,1,0.3,1)"
    }
  },
  "viewport": {
    "xs": 480,
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "xxl": 1536,
    "xxxl": 1920
  },
  "layout": {
    "containerMaxWidth": 1920,
    "navHeight": 56,
    "sectionSpacing": 96
  },
  "componentGrammar": {
    "signatures": {
      "button": {
        "archetype": "actionable",
        "borderRadius": "md",
        "padding": "8px 14px",
        "typography": "button",
        "states": {
          "primary": {
            "backgroundColor": "{colors.primary}",
            "textColor": "{colors.on-primary}"
          },
          "primary-pressed": {
            "backgroundColor": "{colors.primary-focus}",
            "textColor": "{colors.on-primary}"
          },
          "primary-hover": {
            "backgroundColor": "{colors.primary-hover}",
            "textColor": "{colors.on-primary}"
          },
          "secondary": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "ghost": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink}"
          },
          "inverse": {
            "backgroundColor": "{colors.inverse-canvas}",
            "textColor": "{colors.inverse-ink}"
          }
        }
      },
      "card": {
        "archetype": "containment",
        "borderRadius": "lg",
        "padding": "24px",
        "typography": "body",
        "states": {
          "pricing": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "pricing-elevated": {
            "backgroundColor": "{colors.surface-2}",
            "textColor": "{colors.ink}"
          },
          "feature": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "product-screenshot": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "testimonial": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "customer-logo": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink-subtle}"
          }
        }
      },
      "input": {
        "archetype": "actionable",
        "borderRadius": "md",
        "padding": "8px 12px",
        "typography": "body",
        "states": {
          "text": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          },
          "text-focused": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          }
        }
      },
      "tab": {
        "archetype": "actionable",
        "borderRadius": "pill",
        "padding": "6px 14px",
        "typography": "button",
        "states": {
          "pricing-default": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink-subtle}"
          },
          "pricing-selected": {
            "backgroundColor": "{colors.surface-2}",
            "textColor": "{colors.ink}"
          }
        }
      },
      "hero": {
        "archetype": "containment",
        "borderRadius": "lg",
        "padding": "48px",
        "typography": "headline",
        "states": {
          "cta": {
            "backgroundColor": "{colors.surface-1}",
            "textColor": "{colors.ink}"
          }
        }
      },
      "data-row": {
        "archetype": "data",
        "borderRadius": "xs",
        "padding": "24px 0",
        "typography": "body",
        "states": {
          "changelog": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink}"
          }
        }
      },
      "badge": {
        "archetype": "indicator",
        "borderRadius": "pill",
        "padding": "2px 8px",
        "typography": "caption",
        "states": {
          "default": {
            "backgroundColor": "{colors.surface-2}",
            "textColor": "{colors.ink-muted}"
          }
        }
      },
      "navigation": {
        "archetype": "navigation",
        "borderRadius": "xs",
        "height": "56px",
        "typography": "body-sm",
        "padding": "64px 32px",
        "states": {
          "top": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink}"
          },
          "default": {
            "backgroundColor": "{colors.canvas}",
            "textColor": "{colors.ink-subtle}"
          }
        }
      }
    }
  }
}