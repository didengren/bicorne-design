{
  "meta": {
    "name": "dark-theme-template",
    "version": "0.1.0",
    "theme": "dark",
    "platform": "desktop",
    "description": "Default dark theme template with placeholder values"
  },
  "colors": {
    "brand": {
      "50": "#eef0ff",
      "100": "#d9e0ff",
      "200": "#b3c1ff",
      "300": "#8da2ff",
      "400": "#6783ff",
      "500": "#5e6ad2",
      "600": "#4a54a8",
      "700": "#373f7e",
      "800": "#242a54",
      "900": "#11152a"
    },
    "surface": {
      "base": "#010102",
      "1": "#0f1011",
      "2": "#141516",
      "3": "#18191a",
      "4": "#1c1d1e"
    },
    "ink": {
      "default": "#f7f8f8",
      "muted": "#d0d6e0",
      "subtle": "#8a8f98",
      "tertiary": "#62666d"
    },
    "border": {
      "default": "#23252a",
      "strong": "#34343a",
      "subtle": "#3e3e44"
    },
    "semantic": {
      "success": "#27a644",
      "danger": "#e5484d",
      "warning": "#f5a623",
      "info": "#5e6ad2"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "name": "System Display",
        "stack": "'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif"
      },
      "body": {
        "name": "System Body",
        "stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "mono": {
        "name": "System Mono",
        "stack": "ui-monospace, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', Menlo, Monaco, monospace"
      }
    },
    "scales": {
      "display-xl": { "fontFamily": "display", "fontSize": "80px", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-3.0px" },
      "display-lg": { "fontFamily": "display", "fontSize": "56px", "fontWeight": 600, "lineHeight": 1.10, "letterSpacing": "-1.8px" },
      "display-md": { "fontFamily": "display", "fontSize": "40px", "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": "-1.0px" },
      "headline": { "fontFamily": "display", "fontSize": "28px", "fontWeight": 600, "lineHeight": 1.20, "letterSpacing": "-0.6px" },
      "heading-xl": { "fontFamily": "display", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.30, "letterSpacing": "-0.5px" },
      "heading-lg": { "fontFamily": "display", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.35, "letterSpacing": "-0.3px" },
      "heading-md": { "fontFamily": "body", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.40, "letterSpacing": "0px" },
      "body-lg": { "fontFamily": "body", "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "-0.1px" },
      "body-md": { "fontFamily": "body", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "body-sm": { "fontFamily": "body", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "caption": { "fontFamily": "body", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.40, "letterSpacing": "0px" },
      "eyebrow": { "fontFamily": "body", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.4px" },
      "micro": { "fontFamily": "body", "fontSize": "11px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.5px" },
      "button": { "fontFamily": "body", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.20, "letterSpacing": "0px" },
      "mono": { "fontFamily": "mono", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" }
    }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "borderRadius": { "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 24, "full": 9999 },
  "shadows": {
    "sm": { "value": "0 1px 2px rgba(0,0,0,0.3)" },
    "md": { "value": "0 4px 8px rgba(0,0,0,0.3)" },
    "lg": { "value": "0 8px 24px rgba(0,0,0,0.4)" },
    "brand": { "value": "0 4px 12px rgba(94,106,210,0.25)" }
  },
  "transitions": {
    "default": { "duration": "200ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "fast": { "duration": "100ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "slow": { "duration": "300ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" }
  },
  "viewport": { "xs": 480, "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "xxl": 1536, "xxxl": 1920 }
}
