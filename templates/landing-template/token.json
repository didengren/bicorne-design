/**
 * Resend-style landing tokens.
 * 极简明亮：白底 + 1 个高亮色 (#FF5C1B 橙) + 大量留白。
 * 命名空间 `land-` 避免和 dashboard verification 冲突。
 */
{
  "colors": {
    "bg": "#ffffff",
    "panel": "#fafaf9",
    "surface": { "1": "#ffffff", "2": "#fafaf9", "3": "#f5f5f4" },
    "border": { "soft": "#e7e5e4", "faint": "#f0eeec" },
    "text": {
      "default": "#0a0a0a",
      "muted": "#57534e",
      "dim": "#a8a29e",
      "onAccent": "#ffffff"
    },
    "accent": {
      "primary": "#FF5C1B",
      "primaryHover": "#E54A0E",
      "primarySoft": "#FFF1EA"
    },
    "mac": {
      "red": "#ff5f57",
      "yellow": "#febc2e",
      "green": "#28c840"
    }
  },
  "spacing": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32,
    "10": 40, "12": 48, "14": 56, "16": 64, "20": 80, "24": 96, "32": 128
  },
  "borderRadius": {
    "sm": 4, "md": 6, "lg": 10, "xl": 14, "2xl": 20, "pill": 9999
  },
  "shadows": {
    "panel": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "elevated": "0 8px 32px rgba(0, 0, 0, 0.06)",
    "hero": "0 24px 64px rgba(10, 10, 10, 0.08)"
  },
  "fontFamilies": {
    "display": "Inter, 'PingFang SC', system-ui, sans-serif",
    "body": "Inter, 'PingFang SC', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'SF Mono', monospace"
  },
  "animations": {
    "fadeUp":   { "duration": "600ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "fillMode": "both" },
    "fadeIn":   { "duration": "400ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)",  "fillMode": "both" },
    "shimmer":  { "duration": "2.4s",  "easing": "linear" },
    "float":    { "duration": "6s",    "easing": "ease-in-out" },
    "marquee":  { "duration": "30s",   "easing": "linear" }
  },
  "keyframes": {
    "fadeUp":   { "0%": { "opacity": "0", "transform": "translateY(12px)" }, "100%": { "opacity": "1", "transform": "translateY(0)" } },
    "fadeIn":   { "0%": { "opacity": "0" }, "100%": { "opacity": "1" } },
    "shimmer":  { "0%": { "backgroundPosition": "0% 50%" }, "100%": { "backgroundPosition": "200% 50%" } },
    "float":    { "0%,100%": { "transform": "translateY(0px)" }, "50%": { "transform": "translateY(-6px)" } },
    "marquee":  { "0%": { "transform": "translateX(0)" }, "100%": { "transform": "translateX(-50%)" } }
  }
}
