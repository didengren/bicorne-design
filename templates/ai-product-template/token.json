/**
 * Cursor-style IDE tokens (dark VSCode-derived).
 * 命名空间 `ai-` 避免和其他 verification 冲突。
 * Highlight: 暗色 IDE + 紫色 AI 强调（与 Claude 暖橙、ChatGPT 绿蓝刻意区分）。
 */
{
  "colors": {
    "bg": "#0a0a0a",
    "panel": "#161616",
    "surface": {
      "1": "#1e1e1e",
      "2": "#252526",
      "3": "#2d2d30",
      "elevated": "#2a2a2a"
    },
    "border": {
      "subtle": "#2d2d30",
      "faint": "#1f1f1f",
      "focus": "#7c3aed"
    },
    "text": {
      "default": "#d4d4d4",
      "muted": "#858585",
      "dim": "#5a5a5a",
      "onAccent": "#ffffff"
    },
    "accent": {
      "primary": "#7c3aed",
      "primaryHover": "#6d28d9",
      "primarySoft": "#2a1a4a",
      "ai": "#a78bfa"
    },
    "code": {
      "bg": "#0d0d0d",
      "text": "#d4d4d4",
      "keyword": "#c586c0",
      "string": "#ce9178",
      "function": "#dcdcaa",
      "comment": "#6a9955",
      "number": "#b5cea8"
    },
    "tool": {
      "bg": "#1a1a1a",
      "border": "#3a3a3a",
      "icon": "#858585"
    },
    "status": {
      "success": "#4ec9b0",
      "error": "#f48771",
      "warning": "#dcdcaa",
      "running": "#a78bfa",
      "muted": "#858585"
    },
    "citation": {
      "bg": "#1a1a2e",
      "border": "#3a3a5a"
    },
    "mac": {
      "red": "#ff5f57",
      "yellow": "#febc2e",
      "green": "#28c840"
    }
  },
  "spacing": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32
  },
  "borderRadius": {
    "sm": 4, "md": 6, "lg": 8, "xl": 12, "2xl": 16
  },
  "shadows": {
    "panel": "0 1px 3px rgba(0, 0, 0, 0.4)",
    "elevated": "0 4px 16px rgba(0, 0, 0, 0.5)",
    "ai-glow": "0 0 0 1px #7c3aed, 0 0 12px rgba(124, 58, 237, 0.3)"
  },
  "fontFamilies": {
    "display": "Inter, 'PingFang SC', system-ui, sans-serif",
    "body": "Inter, 'PingFang SC', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'SF Mono', 'Cascadia Code', monospace"
  },
  "animations": {
    "fadeUp":   { "duration": "400ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "fillMode": "both" },
    "fadeIn":   { "duration": "300ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)",  "fillMode": "both" },
    "stream":   { "duration": "30ms",  "easing": "linear" },
    "pulse":    { "duration": "1500ms", "easing": "cubic-bezier(0.4, 0, 0.6, 1)" }
  },
  "keyframes": {
    "fadeUp":   { "0%": { "opacity": "0", "transform": "translateY(8px)" }, "100%": { "opacity": "1", "transform": "translateY(0)" } },
    "fadeIn":   { "0%": { "opacity": "0" }, "100%": { "opacity": "1" } },
    "pulse":    { "0%,100%": { "opacity": "1" }, "50%": { "opacity": "0.4" } },
    "stream":   { "0%": { "opacity": "0.6" }, "100%": { "opacity": "1" } }
  }
}
