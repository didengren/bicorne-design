{
  "meta": {
    "name": "dashboard-dark-template",
    "version": "0.1.0",
    "theme": "dark",
    "platform": "dashboard",
    "description": "Dashboard dark theme template. Same brand shares colors + fontFamilies + viewport + transitions across platforms. Differences: typography.scales (font sizes), spacing, borderRadius, shadows. Primary design range: xl–xxxl (1280–1920+px). Dashboard only supports dark theme."
  },
  "colors": {
    "brand": {
      "50": "#eef0ff",
      "100": "#d9e0ff",
      "200": "#b3c1ff",
      "300": "#8da2ff",
      "400": "#6783ff",
      "500": "#5e6ad2",
      "600": "#4a54a8",
      "700": "#373f7e",
      "800": "#242a54",
      "900": "#11152a"
    },
    "surface": {
      "base": "#010102",
      "1": "#0f1011",
      "2": "#141516",
      "3": "#18191a",
      "4": "#1c1d1e"
    },
    "ink": {
      "default": "#f7f8f8",
      "muted": "#d0d6e0",
      "subtle": "#8a8f98",
      "tertiary": "#62666d"
    },
    "border": {
      "default": "#23252a",
      "strong": "#34343a",
      "subtle": "#3e3e44"
    },
    "semantic": {
      "success": "#27a644",
      "danger": "#e5484d",
      "warning": "#f5a623",
      "info": "#5e6ad2"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "name": "System Display",
        "stack": "'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif",
        "fontDisplay": "swap",
        "fontWeight": [400, 500, 600, 700, 800, 900],
        "openTypeFeatures": ["tnum", "cv11"]
      },
      "body": {
        "name": "System Body",
        "stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "fontDisplay": "swap",
        "fontWeight": [400, 500, 600, 700],
        "openTypeFeatures": ["cv11"]
      },
      "mono": {
        "name": "System Mono",
        "stack": "ui-monospace, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', Menlo, Monaco, monospace",
        "fontDisplay": "swap",
        "fontWeight": [400, 500, 700],
        "openTypeFeatures": ["tnum", "calt"]
      }
    },
    "scales": {
      "display-xl": { "fontFamily": "display", "fontSize": "96px", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-3.0px" },
      "display-lg": { "fontFamily": "display", "fontSize": "72px", "fontWeight": 600, "lineHeight": 1.10, "letterSpacing": "-1.8px" },
      "display-md": { "fontFamily": "display", "fontSize": "56px", "fontWeight": 600, "lineHeight": 1.15, "letterSpacing": "-1.0px" },
      "headline": { "fontFamily": "display", "fontSize": "44px", "fontWeight": 600, "lineHeight": 1.20, "letterSpacing": "-0.6px" },
      "heading-xl": { "fontFamily": "display", "fontSize": "36px", "fontWeight": 600, "lineHeight": 1.30, "letterSpacing": "-0.5px" },
      "heading-lg": { "fontFamily": "display", "fontSize": "30px", "fontWeight": 600, "lineHeight": 1.35, "letterSpacing": "-0.3px" },
      "heading-md": { "fontFamily": "body", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.40, "letterSpacing": "0px" },
      "body-lg": { "fontFamily": "body", "fontSize": "22px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "-0.1px" },
      "body-md": { "fontFamily": "body", "fontSize": "20px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "body-sm": { "fontFamily": "body", "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "caption": { "fontFamily": "body", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.40, "letterSpacing": "0px" },
      "eyebrow": { "fontFamily": "body", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.4px" },
      "micro": { "fontFamily": "body", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.5px" },
      "button": { "fontFamily": "body", "fontSize": "16px", "fontWeight": 500, "lineHeight": 1.20, "letterSpacing": "0px" },
      "mono": { "fontFamily": "mono", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" }
    }
  },
  "spacing": { "1": 8, "2": 16, "3": 24, "4": 32, "5": 40, "6": 48, "8": 64, "10": 80, "12": 96, "16": 128 },
  "borderRadius": { "none": 0, "xs": 6, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 28, "full": 9999 },
  "shadows": {
    "sm": { "value": "0 2px 4px rgba(0,0,0,0.45)" },
    "md": { "value": "0 6px 12px rgba(0,0,0,0.45)" },
    "lg": { "value": "0 12px 36px rgba(0,0,0,0.6)" },
    "brand": { "value": "0 6px 18px rgba(94,106,210,0.375)" }
  },
  "transitions": {
    "default": { "duration": "200ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "fast": { "duration": "100ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "slow": { "duration": "300ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "expand": { "duration": "200ms", "easing": "ease-in-out" },
    "collapse": { "duration": "150ms", "easing": "ease-in" },
    "modal-enter": { "duration": "280ms", "easing": "ease-out" },
    "modal-exit": { "duration": "180ms", "easing": "ease-in" },
    "toast-enter": { "duration": "300ms", "easing": "ease-out" },
    "toast-exit": { "duration": "200ms", "easing": "ease-in" },
    "scroll-reveal": { "duration": "500ms", "easing": "cubic-bezier(0.16,1,0.3,1)" }
  },
  "viewport": { "xs": 480, "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "xxl": 1536, "xxxl": 1920 },
  "componentGrammar": {
    "signatures": {
      "button": {
        "archetype": "actionable",
        "borderRadius": "md",
        "padding": "8px 14px",
        "height": "40px",
        "typography": "button",
        "states": {
          "primary": {
            "backgroundColor": "{colors.brand.500}",
            "textColor": "#ffffff"
          },
          "secondary": {
            "backgroundColor": "{colors.surface.1}",
            "textColor": "{colors.ink.default}",
            "border": "1px solid {colors.border.default}"
          },
          "ghost": {
            "backgroundColor": "transparent",
            "textColor": "{colors.ink.default}"
          },
          "disabled": {
            "opacity": 0.5
          }
        }
      },
      "card": {
        "archetype": "containment",
        "borderRadius": "lg",
        "padding": "24px",
        "states": {
          "default": {
            "backgroundColor": "{colors.surface.1}"
          },
          "elevated": {
            "backgroundColor": "{colors.surface.2}"
          }
        }
      },
      "input": {
        "archetype": "actionable",
        "borderRadius": "md",
        "padding": "8px 12px",
        "height": "40px",
        "typography": "body-md",
        "states": {
          "default": {
            "backgroundColor": "{colors.surface.1}",
            "border": "1px solid {colors.border.default}"
          },
          "focused": {
            "border": "2px solid {colors.brand.500}",
            "boxShadow": "0 0 0 2px {colors.brand.500}33"
          }
        }
      },
      "navigation": {
        "archetype": "navigation",
        "height": "56px",
        "states": {
          "default": {
            "backgroundColor": "{colors.surface.base}"
          }
        }
      },
      "badge": {
        "archetype": "indicator",
        "borderRadius": "full",
        "padding": "2px 8px",
        "typography": "caption",
        "states": {
          "default": {
            "backgroundColor": "{colors.brand.500}",
            "textColor": "#ffffff"
          }
        }
      },
      "hero": {
        "archetype": "display",
        "borderRadius": "lg",
        "padding": "24px",
        "states": {
          "default": {
            "backgroundColor": "{colors.surface.base}"
          }
        }
      },
      "data-row": {
        "archetype": "data",
        "padding": "12px 16px",
        "states": {
          "default": {
            "textColor": "{colors.ink.default}"
          }
        }
      }
    }
  },
  "layout": {
    "containerMaxWidth": 1920,
    "navHeight": 64,
    "sectionSpacing": 64
  }
}
