{
  "name": "bicorne-dashboard-template",
  "private": true,
  "version": "2.12.0",
  "type": "module",
  "description": "bicorne-design v2.12 dashboard template · cloned from verification/4-3-dashboard-command-center",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc -b",
    "token:build": "node ../../dashboards/tailwind-bridge/generate.mjs --token ./token.json --prefix dash --out ./tailwind.config.generated.ts"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  }
}