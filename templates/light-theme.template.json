{
  "meta": {
    "name": "light-theme-template",
    "version": "0.1.0",
    "theme": "light",
    "platform": "desktop",
    "description": "Default light theme template with placeholder values"
  },
  "colors": {
    "brand": {
      "50": "#f0f7ff",
      "100": "#c9e2ff",
      "200": "#a1caff",
      "300": "#78aeff",
      "400": "#4f90ff",
      "500": "#2468f2",
      "600": "#144bcc",
      "700": "#0832a6",
      "800": "#001e80",
      "900": "#001259"
    },
    "surface": {
      "base": "#ffffff",
      "1": "#f5f5f5",
      "2": "#fafafa",
      "3": "#f0f0f0",
      "4": "#e8e8e8"
    },
    "ink": {
      "default": "#1a1a1a",
      "muted": "#595959",
      "subtle": "#8c8c8c",
      "tertiary": "#bfbfbf"
    },
    "border": {
      "default": "#d9d9d9",
      "strong": "#bfbfbf",
      "subtle": "#f0f0f0"
    },
    "semantic": {
      "success": "#52c41a",
      "danger": "#f5222d",
      "warning": "#faad14",
      "info": "#2468f2"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "name": "System Display",
        "stack": "'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif"
      },
      "body": {
        "name": "System Body",
        "stack": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "mono": {
        "name": "System Mono",
        "stack": "ui-monospace, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', Menlo, Monaco, monospace"
      }
    },
    "scales": {
      "display-xl": { "fontFamily": "display", "fontSize": "48px", "fontWeight": 700, "lineHeight": 1.10, "letterSpacing": "-1.5px" },
      "display-lg": { "fontFamily": "display", "fontSize": "40px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-1.0px" },
      "display-md": { "fontFamily": "display", "fontSize": "32px", "fontWeight": 600, "lineHeight": 1.20, "letterSpacing": "-0.5px" },
      "headline": { "fontFamily": "display", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.30, "letterSpacing": "-0.3px" },
      "heading-xl": { "fontFamily": "display", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.35, "letterSpacing": "-0.2px" },
      "heading-lg": { "fontFamily": "display", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.40, "letterSpacing": "0px" },
      "heading-md": { "fontFamily": "body", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.40, "letterSpacing": "0px" },
      "body-lg": { "fontFamily": "body", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.60, "letterSpacing": "0px" },
      "body-md": { "fontFamily": "body", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "body-sm": { "fontFamily": "body", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.50, "letterSpacing": "0px" },
      "caption": { "fontFamily": "body", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.40, "letterSpacing": "0.01px" },
      "eyebrow": { "fontFamily": "body", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.4px" },
      "micro": { "fontFamily": "body", "fontSize": "11px", "fontWeight": 500, "lineHeight": 1.30, "letterSpacing": "0.5px" },
      "button": { "fontFamily": "body", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.20, "letterSpacing": "0px" },
      "mono": { "fontFamily": "mono", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.70, "letterSpacing": "0px" }
    }
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "borderRadius": { "none": 0, "xs": 4, "sm": 4, "md": 6, "lg": 8, "xl": 12, "2xl": 16, "full": 9999 },
  "shadows": {
    "sm": { "value": "0 1px 2px rgba(0,0,0,0.05)" },
    "md": { "value": "0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04)" },
    "lg": { "value": "0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04)" },
    "brand": { "value": "0 4px 14px rgba(36,104,242,0.25)" }
  },
  "transitions": {
    "default": { "duration": "200ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "fast": { "duration": "100ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" },
    "slow": { "duration": "300ms", "easing": "cubic-bezier(0.215,0.61,0.355,1)" }
  },
  "viewport": { "xs": 480, "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "xxl": 1536, "xxxl": 1920 }
}
