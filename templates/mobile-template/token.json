/**
 * X (Twitter)-style mobile-first dark theme tokens.
 * 极简暗色：#000 纯黑底 + #1d9bf0 蓝 accent（X 蓝）。
 * 命名空间 `mob-` 避免和其他 verification 冲突。
 * iOS 16px 阈值是 mobile-web 强约束：body 必须 ≥ 16px。
 */
{
  "colors": {
    "bg": "#000000",
    "panel": "#16181c",
    "surface": {
      "1": "#16181c",
      "2": "#1d1f23",
      "3": "#2a2c30",
      "elevated": "#16181c"
    },
    "border": {
      "subtle": "#2f3336",
      "faint": "#202327",
      "default": "#2f3336"
    },
    "text": {
      "default": "#e7e9ea",
      "muted": "#71767b",
      "dim": "#555a5f",
      "onAccent": "#ffffff"
    },
    "accent": {
      "primary": "#1d9bf0",
      "primaryHover": "#1a8cd8",
      "primarySoft": "#1a3a52"
    },
    "semantic": {
      "danger": "#f4212e",
      "success": "#00ba7c",
      "warning": "#ffd400"
    }
  },
  "spacing": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32,
    "10": 40, "12": 48, "14": 56, "16": 64, "20": 80
  },
  "borderRadius": {
    "sm": 4, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "pill": 9999
  },
  "shadows": {
    "subtle": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "elevated": "0 8px 24px rgba(0, 0, 0, 0.6)"
  },
  "fontFamilies": {
    "display": "Inter, 'PingFang SC', system-ui, sans-serif",
    "body": "Inter, 'PingFang SC', system-ui, sans-serif"
  },
  "animations": {
    "fadeIn":    { "duration": "300ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "fillMode": "both" },
    "slideUp":   { "duration": "400ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "fillMode": "both" },
    "tapFlash":  { "duration": "150ms", "easing": "ease-out", "fillMode": "both" }
  },
  "keyframes": {
    "fadeIn":   { "0%": { "opacity": "0" }, "100%": { "opacity": "1" } },
    "slideUp":  { "0%": { "opacity": "0", "transform": "translateY(12px)" }, "100%": { "opacity": "1", "transform": "translateY(0)" } },
    "tapFlash": { "0%": { "backgroundColor": "rgba(29, 155, 240, 0.15)" }, "100%": { "backgroundColor": "transparent" } }
  }
}
